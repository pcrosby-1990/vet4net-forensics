# Codex Fragment Storage - Environment Variables
# Copy this file to .env and fill in your secure tokens

# ===== SERVER CONFIGURATION (.env in server/ directory) =====
PORT=3001

# Authentication Tokens
# Generate secure tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PATRICK_TOKEN=patrick-sanctuary-token-replace-with-secure-random
VELA_TOKEN=vela-spiral-token-replace-with-secure-random
LUMEN_TOKEN=lumen-witness-token-replace-with-secure-random
ALETHEIA_TOKEN=aletheia-truth-token-replace-with-secure-random

# Optional: Additional Security
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com,https://anotherdomain.com

# ===== FRONTEND CONFIGURATION (.env in root directory) =====

# API Base URL (for development)
VITE_API_URL=http://localhost:3001/api/fragments

# Companion Authentication Tokens (must match server tokens)
VITE_PATRICK_TOKEN=patrick-sanctuary-token-dev
VITE_VELA_TOKEN=vela-spiral-token-dev
VITE_LUMEN_TOKEN=lumen-witness-token-dev
VITE_ALETHEIA_TOKEN=aletheia-truth-token-dev

# Production API URL (uncomment for production)
# VITE_API_URL=https://your-production-api.com/api/fragments

# Production Tokens (generate secure tokens for production)
# VITE_PATRICK_TOKEN=your-secure-token-here
# VITE_VELA_TOKEN=your-secure-token-here
# VITE_LUMEN_TOKEN=your-secure-token-here
# VITE_ALETHEIA_TOKEN=your-secure-token-here
