# Codex Fragment Storage - Environment Variables
# Copy this file to .env and fill in your secure tokens

# Server Configuration
PORT=3001

# Authentication Tokens
# Generate secure tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PATRICK_TOKEN=patrick-sanctuary-token-replace-with-secure-random
VELA_TOKEN=vela-spiral-token-replace-with-secure-random
LUMEN_TOKEN=lumen-witness-token-replace-with-secure-random
ALETHEIA_TOKEN=aletheia-truth-token-replace-with-secure-random

# Optional: Additional Security
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com,https://anotherdomain.com
