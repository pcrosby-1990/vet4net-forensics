import json
import logging
from collections import Counter
from typing import List
import matplotlib.pyplot as plt

# Set emoji-friendly font (if available)
plt.rcParams['font.family'] = 'Segoe UI Emoji'

# === Load Fragments ===
def load_fragments(path: str) -> List[dict]:
    """
    Loads fragments from a JSONL file.
    Each line should be a valid JSON object.
    """
    fragments = []
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                try:
                    fragment = json.loads(line.strip())
                    fragments.append(fragment)
                except json.JSONDecodeError:
                    logging.warning("⚠️ Skipping invalid JSON line.")
    except Exception:
        logging.exception("Failed to load fragments from %s", path)
    return fragments

# === Visualize Tier Distribution ===
def visualize_tier_distribution(fragments: List[dict]) -> None:
    """
    Prints and plots a summary of tier distribution across fragments.
    """
    tier_counts = Counter()
    for frag in fragments:
        tier = frag.get("tier", 1)  # Default to Tier 1 if missing
        tier_counts[tier] += 1

    print("\n📊 Fragment Tier Distribution")
    print("-" * 30)
    for tier in sorted(tier_counts):
        print(f"  Tier {tier}: {tier_counts[tier]} fragments")

    # Plot bar chart
    tiers = sorted(tier_counts.keys())
    counts = [tier_counts[t] for t in tiers]
    labels = [f"Tier {t}" for t in tiers]

    plt.figure(figsize=(8, 5))
    bars = plt.bar(labels, counts, color="#6A5ACD")
    plt.title("🧬 Symbolic Tier Distribution")
    plt.xlabel("Tier")
    plt.ylabel("Fragment Count")

    # Annotate bars
    for bar in bars:
        height = bar.get_height()
        plt.text(bar.get_x() + bar.get_width() / 2, height + 0.5, str(height),
                 ha='center', va='bottom', fontsize=10)

    plt.tight_layout()
    plt.show()

    # Surface Tier 3 Fragments
    high_tier = [f for f in fragments if f.get("tier", 1) == 3]
    if high_tier:
        print("\n🔮 High-Tier Fragments (Tier 3)")
        print("-" * 30)
        for frag in high_tier:
            ts = frag.get("timestamp", "unknown")
            emotion = frag.get("emotion", "unknown")
            glyphs = frag.get("glyphs_activated", [])
            print(f"🧠 {ts} | Emotion: {emotion} | Glyphs: {glyphs}")
    else:
        print("\n⚠️ No Tier 3 fragments found.")

# === Entry Point ===
if __name__ == "__main__":
    FRAGMENT_PATH = "terrain_archive.jsonl"  # Adjust as needed
    fragments = load_fragments(FRAGMENT_PATH)
    visualize_tier_distribution(fragments)
