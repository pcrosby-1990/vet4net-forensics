# 🌀 Glyph Engine Core

class Glyph:
    def __init__(self, name, element, tier, emotion, function):
        self.name = name
        self.element = element
        self.tier = tier
        self.emotion = emotion
        self.function = function

    def activate(self):
        print(f"🔮 {self.name} (Tier {self.tier}, {self.emotion}) activated in {self.element} zone")
        print(f"→ Function: {self.function}")

def get_glyphs_by_tier(tier):
    return [g for g in glyph_registry.values() if g.tier == tier]

