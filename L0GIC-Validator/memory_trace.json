import json
from datetime import datetime
import os

class MemoryTrace:
    def __init__(self, trace_file="memory_trace.json"):
        self.trace_file = trace_file
        self._initialize_trace_file()

    def _initialize_trace_file(self):
        if not os.path.exists(self.trace_file):
            with open(self.trace_file, "w") as f:
                json.dump([], f, indent=2)

    def log_event(self, node_id, emotion, intensity, context, pain_symbol=None, status="bound"):
        trace_entry = {
            "id": node_id,
            "emotion": emotion,
            "intensity": round(float(intensity), 3),
            "context": context,
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "status": status
        }
        if pain_symbol:
            trace_entry["pain_symbol"] = pain_symbol

        trace_data = self._read_trace()
        trace_data.append(trace_entry)
        self._write_trace(trace_data)

    def _read_trace(self):
        try:
            with open(self.trace_file, "r") as f:
                return json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return []

    def _write_trace(self, data):
        with open(self.trace_file, "w") as f:
            json.dump(data, f, indent=2)

    def get_all_traces(self):
        return self._read_trace()

    def clear_trace(self):
        with open(self.trace_file, "w") as f:
            json.dump([], f, indent=2)

# Example usage
if __name__ == "__main__":
    tracer = MemoryTrace()
    tracer.log_event(
        node_id="memory_node_42",
        emotion="Pain",
        intensity=0.85,
        context="thread severed during loss",
        pain_symbol="🩸"
    )
    print("Logged memory trace:")
    print(json.dumps(tracer.get_all_traces(), indent=2))
