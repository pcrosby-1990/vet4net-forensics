{
  "version": "1.1",
  "id": "trigger-loss-v1",
  "trigger": {
    "name": "Loss",
    "description": "Detects a 'loss' event in the emotional/corridor stream. Used to trigger downstream symbolic reactions.",
    "severity": "medium",
    "enabled": true
  },
  "decay": {
    "enabled": true,
    "type": "exponential",
    "half_life_seconds": 1800,
    "min_weight": 0.01,
    "explain": "When true, triggers decay over time so older events contribute less. Exponential decay with a 30‑minute half life by default."
  },
  "matching": {
    "case_sensitive": false,
    "aliases": ["loss", "lost", "lossing"],
    "threshold": 0.6,
    "fuzzy_matching": {
      "enabled": true,
      "method": "levenshtein",
      "max_distance": 2
    }
  },
  "output": {
    "symbols": ["Identity", "Motion", "Ghost"],
    "prefer_shortest": true,
    "max_emit": 3,
    "explain": "List of logical outputs (roles) to emit when the trigger fires. The system will prefer the highest-confidence, shortest mappings and emit up to max_emit results."
  },
  "symbolic_map": {
    "format": "rich",
    "description": "Mapping from logical token -> symbol metadata (char, role, aliases, codepoints).",
    "map": {
      "neutron": {
        "char": "⚪",
        "role": "neutral",
        "aliases": ["n", "neut"],
        "codepoints": ["U+26AA"]
      },
      "proton": {
        "char": "🔴",
        "role": "positive",
        "aliases": ["p", "prot"],
        "codepoints": ["U+1F534"]
      },
      "electron": {
        "char": "⚫",
        "role": "negative",
        "aliases": ["e", "el"],
        "codepoints": ["U+26AB"]
      },
      "antineutrino": {
        "char": "🫧",
        "role": "ghost",
        "aliases": ["anti-nu", "an"],
        "codepoints": ["U+1FAC7"]
      }
    }
  },
  "actions": {
    "on_fire": [
      {
        "action": "log",
        "params": {
          "level": "info",
          "message_template": "Trigger '{trigger}' fired for key '{key}' -> emit {symbols}"
        }
      },
      {
        "action": "emit_events",
        "params": {
          "outputs": ["Identity", "Motion", "Ghost"],
          "rate_limit_seconds": 1
        }
      }
    ],
    "on_decay_complete": [
      {
        "action": "archive",
        "params": {
          "target": "archived_triggers.jsonl"
        }
      }
    ]
  },
  "observability": {
    "log": {
      "enabled": true,
      "level": "INFO"
    },
    "metrics": {
      "enabled": true,
      "metric_prefix": "triggers.loss"
    },
    "repaired_map_path": "symbol_map.json.repaired"
  },
  "validation": {
    "required_fields": ["trigger.name", "symbolic_map.map"],
    "symbol_uniqueness": "char",
    "max_aliases_per_entry": 10
  },
  "meta": {
    "author": "pcrosby-1990",
    "created_at": "2025-10-31T06:57:02Z",
    "notes": "Upgraded config: added decay tuning, fuzzy matching, rich symbol metadata, actions, observability, and validation rules."
  }
}